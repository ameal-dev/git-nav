#!/usr/bin/env bash
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  git-nav: Smart Git Branch Navigator
#  Fuzzy search, recent branches, numbered switching & more
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

set -euo pipefail

# ── Config ──────────────────────────────────────────────────
HISTORY_FILE="$HOME/.git-nav-history"
MAX_HISTORY=20
COLOR_RESET="\033[0m"
COLOR_GREEN="\033[1;32m"
COLOR_YELLOW="\033[1;33m"
COLOR_CYAN="\033[1;36m"
COLOR_DIM="\033[2m"
COLOR_RED="\033[1;31m"
COLOR_BOLD="\033[1m"
COLOR_MAGENTA="\033[1;35m"

# ── Helpers ─────────────────────────────────────────────────
ensure_git_repo() {
  git rev-parse --is-inside-work-tree &>/dev/null || {
    echo -e "${COLOR_RED}Error: Not inside a git repository.${COLOR_RESET}"
    exit 1
  }
}

current_branch() {
  git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD
}

copy_to_clipboard() {
  if command -v pbcopy &>/dev/null; then
    echo -n "$1" | pbcopy
  elif command -v xclip &>/dev/null; then
    echo -n "$1" | xclip -selection clipboard
  elif command -v wl-copy &>/dev/null; then
    echo -n "$1" | wl-copy
  else
    echo -e "${COLOR_YELLOW}Warning: No clipboard tool found (pbcopy/xclip/wl-copy)${COLOR_RESET}" >&2
    return 1
  fi
}

title_case() {
  echo "$1" | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2); print}'
}

detect_base_branch() {
  if git show-ref --verify --quiet "refs/heads/main" 2>/dev/null; then
    echo "main"
  elif git show-ref --verify --quiet "refs/heads/master" 2>/dev/null; then
    echo "master"
  else
    echo "main"
  fi
}

record_switch() {
  local branch="$1"
  touch "$HISTORY_FILE"
  # Remove duplicates, prepend new entry, trim to max
  grep -vxF "$branch" "$HISTORY_FILE" > "${HISTORY_FILE}.tmp" 2>/dev/null || true
  { echo "$branch"; cat "${HISTORY_FILE}.tmp"; } | head -n "$MAX_HISTORY" > "$HISTORY_FILE"
  rm -f "${HISTORY_FILE}.tmp"
}

do_switch() {
  local branch="$1"
  local current
  current=$(current_branch)

  if [[ "$branch" == "$current" ]]; then
    echo -e "${COLOR_YELLOW}Already on ${COLOR_BOLD}$branch${COLOR_RESET}"
    return 0
  fi

  if git checkout "$branch" 2>/dev/null; then
    record_switch "$branch"
    echo -e "${COLOR_GREEN}✓ Switched to ${COLOR_BOLD}$branch${COLOR_RESET}"
  else
    echo -e "${COLOR_RED}✗ Failed to switch to ${COLOR_BOLD}$branch${COLOR_RESET}"
    return 1
  fi
}

format_branch_name() {
  local branch="$1"
  local current="$2"
  local prefix=""

  [[ "$branch" == "$current" ]] && prefix="${COLOR_GREEN}● "

  # Colorize: prefix/TICKET-description
  if [[ "$branch" =~ ^([^/]+)/([A-Z]+-[0-9]+)(-.*)?$ ]]; then
    local type="${BASH_REMATCH[1]}"
    local ticket="${BASH_REMATCH[2]}"
    local desc="${BASH_REMATCH[3]//-/ }"
    echo -e "${prefix}${COLOR_DIM}${type}/${COLOR_RESET}${COLOR_CYAN}${ticket}${COLOR_RESET}${COLOR_DIM}${desc}${COLOR_RESET}"
  elif [[ "$branch" =~ ^([^/]+)/(.+)$ ]]; then
    local type="${BASH_REMATCH[1]}"
    local rest="${BASH_REMATCH[2]//-/ }"
    echo -e "${prefix}${COLOR_DIM}${type}/${COLOR_RESET}${rest}"
  else
    echo -e "${prefix}${COLOR_BOLD}${branch}${COLOR_RESET}"
  fi
}

# Fuzzy-search branches by query, show numbered list, echo selected branch name
# to stdout. All UI (menu, prompts) goes to stderr so callers can use $().
# Auto-selects silently when only one branch matches.
pick_branch() {
  local query="$1"

  local fuzzy_pattern=""
  for (( i=0; i<${#query}; i++ )); do
    local char="${query:$i:1}"
    char=$(printf '%s' "$char" | sed 's/[][\\.^$*+?{}()|]/\\&/g')
    fuzzy_pattern+="${char}.*"
  done
  fuzzy_pattern="${fuzzy_pattern%.\*}"

  local branches
  branches=$(git branch --all --format='%(refname:short)' | \
    sed 's|^origin/||' | sort -u | \
    grep -iE "$fuzzy_pattern" 2>/dev/null || true)

  if [[ -z "$branches" ]]; then
    echo -e "${COLOR_YELLOW}No branches matching '${query}'${COLOR_RESET}" >&2
    return 1
  fi

  local count
  count=$(echo "$branches" | wc -l | tr -d ' ')

  if [[ "$count" -eq 1 ]]; then
    echo -e "${COLOR_CYAN}Found: ${COLOR_RESET}${branches}" >&2
    echo "$branches"
    return 0
  fi

  local current
  current=$(current_branch)

  local i=1
  while IFS= read -r branch; do
    local formatted
    formatted=$(format_branch_name "$branch" "$current")
    printf "  ${COLOR_YELLOW}%2d${COLOR_RESET}  %b\n" "$i" "$formatted" >&2
    ((i++))
  done <<< "$branches"

  echo "" >&2
  echo -ne "${COLOR_DIM}Select branch #: ${COLOR_RESET}" >&2
  read -r choice

  if [[ "$choice" =~ ^[0-9]+$ ]]; then
    local target
    target=$(echo "$branches" | sed -n "${choice}p")
    if [[ -n "$target" ]]; then
      echo "$target"
    else
      echo -e "${COLOR_RED}Invalid selection.${COLOR_RESET}" >&2
      return 1
    fi
  else
    echo -e "${COLOR_DIM}No selection made.${COLOR_RESET}" >&2
    return 1
  fi
}

# ── Commands ────────────────────────────────────────────────

cmd_search() {
  local query="${1:-}"
  if [[ -z "$query" ]]; then
    echo -e "${COLOR_RED}Usage: git-nav search <query>${COLOR_RESET}"
    echo -e "${COLOR_DIM}  Fuzzy-matches branch names. Searches tickets, descriptions, types.${COLOR_RESET}"
    return 1
  fi

  local current
  current=$(current_branch)

  # Build a case-insensitive grep pattern: "abc" → "a.*b.*c"
  local fuzzy_pattern=""
  for (( i=0; i<${#query}; i++ )); do
    local char="${query:$i:1}"
    # Escape regex-special chars
    char=$(printf '%s' "$char" | sed 's/[][\\.^$*+?{}()|]/\\&/g')
    fuzzy_pattern+="${char}.*"
  done
  # Remove trailing .*
  fuzzy_pattern="${fuzzy_pattern%.\*}"

  local branches
  branches=$(git branch --all --format='%(refname:short)' | \
    sed 's|^origin/||' | sort -u | \
    grep -iE "$fuzzy_pattern" 2>/dev/null || true)

  if [[ -z "$branches" ]]; then
    echo -e "${COLOR_YELLOW}No branches matching '${query}'${COLOR_RESET}"
    return 0
  fi

  local count
  count=$(echo "$branches" | wc -l | tr -d ' ')

  if [[ "$count" -eq 1 ]]; then
    do_switch "$branches"
    return 0
  fi

  echo -e "${COLOR_BOLD}Branches matching '${query}':${COLOR_RESET}\n"

  local i=1
  while IFS= read -r branch; do
    local formatted
    formatted=$(format_branch_name "$branch" "$current")
    printf "  ${COLOR_YELLOW}%2d${COLOR_RESET}  %b\n" "$i" "$formatted"
    ((i++))
  done <<< "$branches"

  echo ""
  echo -ne "${COLOR_DIM}Switch to branch #: ${COLOR_RESET}"
  read -r choice

  if [[ "$choice" =~ ^[0-9]+$ ]]; then
    local target
    target=$(echo "$branches" | sed -n "${choice}p")
    if [[ -n "$target" ]]; then
      do_switch "$target"
    else
      echo -e "${COLOR_RED}Invalid selection.${COLOR_RESET}"
    fi
  elif [[ -n "$choice" ]]; then
    echo -e "${COLOR_DIM}No selection made.${COLOR_RESET}"
  fi
}

cmd_list() {
  local current
  current=$(current_branch)
  local filter="${1:-}"

  echo -e "${COLOR_BOLD}Local branches:${COLOR_RESET}\n"

  local i=1
  while IFS= read -r branch; do
    if [[ -n "$filter" ]] && ! echo "$branch" | grep -qi "$filter"; then
      continue
    fi

    local formatted
    formatted=$(format_branch_name "$branch" "$current")

    # Get last commit age
    local age
    age=$(git log -1 --format='%cr' "$branch" 2>/dev/null || echo "unknown")

    printf "  ${COLOR_YELLOW}%2d${COLOR_RESET}  %-60b ${COLOR_DIM}%s${COLOR_RESET}\n" "$i" "$formatted" "$age"
    ((i++))
  done < <(git branch --format='%(refname:short)' --sort=-committerdate)

  echo ""
  echo -ne "${COLOR_DIM}Switch to branch #: ${COLOR_RESET}"
  read -r choice

  if [[ "$choice" =~ ^[0-9]+$ ]]; then
    local target
    target=$(git branch --format='%(refname:short)' --sort=-committerdate | \
      if [[ -n "$filter" ]]; then grep -i "$filter"; else cat; fi | \
      sed -n "${choice}p")
    if [[ -n "$target" ]]; then
      do_switch "$target"
    fi
  fi
}

cmd_recent() {
  if [[ ! -f "$HISTORY_FILE" ]] || [[ ! -s "$HISTORY_FILE" ]]; then
    echo -e "${COLOR_YELLOW}No branch history yet. Start switching!${COLOR_RESET}"
    return 0
  fi

  local current
  current=$(current_branch)

  echo -e "${COLOR_BOLD}Recent branches:${COLOR_RESET}\n"

  local i=1
  while IFS= read -r branch; do
    # Only show branches that still exist
    if git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
      local formatted
      formatted=$(format_branch_name "$branch" "$current")
      printf "  ${COLOR_YELLOW}%2d${COLOR_RESET}  %b\n" "$i" "$formatted"
      ((i++))
    fi
  done < "$HISTORY_FILE"

  echo ""
  echo -ne "${COLOR_DIM}Switch to branch #: ${COLOR_RESET}"
  read -r choice

  if [[ "$choice" =~ ^[0-9]+$ ]]; then
    local target
    local j=0
    while IFS= read -r branch; do
      if git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
        ((j++))
        if [[ "$j" -eq "$choice" ]]; then
          target="$branch"
          break
        fi
      fi
    done < "$HISTORY_FILE"

    if [[ -n "${target:-}" ]]; then
      do_switch "$target"
    fi
  fi
}

cmd_back() {
  local steps="${1:-1}"

  if [[ ! -f "$HISTORY_FILE" ]]; then
    echo -e "${COLOR_YELLOW}No history to go back to.${COLOR_RESET}"
    return 1
  fi

  local target
  target=$(sed -n "${steps}p" "$HISTORY_FILE")

  if [[ -z "$target" ]]; then
    echo -e "${COLOR_RED}No branch at position $steps in history.${COLOR_RESET}"
    return 1
  fi

  if ! git show-ref --verify --quiet "refs/heads/$target" 2>/dev/null; then
    echo -e "${COLOR_RED}Branch '${target}' no longer exists.${COLOR_RESET}"
    return 1
  fi

  do_switch "$target"
}

cmd_ticket() {
  local ticket="${1:-}"
  if [[ -z "$ticket" ]]; then
    echo -e "${COLOR_RED}Usage: git-nav ticket <TICKET-ID>${COLOR_RESET}"
    echo -e "${COLOR_DIM}  e.g. git-nav ticket AVEN-43${COLOR_RESET}"
    return 1
  fi

  # Make ticket uppercase for matching
  ticket=$(echo "$ticket" | tr '[:lower:]' '[:upper:]')

  local branches
  branches=$(git branch --all --format='%(refname:short)' | \
    sed 's|^origin/||' | sort -u | \
    grep -i "$ticket" 2>/dev/null || true)

  if [[ -z "$branches" ]]; then
    echo -e "${COLOR_YELLOW}No branches found for ticket '${ticket}'${COLOR_RESET}"
    return 0
  fi

  local count
  count=$(echo "$branches" | wc -l)

  if [[ "$count" -eq 1 ]]; then
    echo -e "${COLOR_CYAN}Found: ${COLOR_RESET}$branches"
    do_switch "$branches"
  else
    local current
    current=$(current_branch)
    echo -e "${COLOR_BOLD}Branches for ticket '${ticket}':${COLOR_RESET}\n"
    local i=1
    while IFS= read -r branch; do
      local formatted
      formatted=$(format_branch_name "$branch" "$current")
      printf "  ${COLOR_YELLOW}%2d${COLOR_RESET}  %b\n" "$i" "$formatted"
      ((i++))
    done <<< "$branches"

    echo ""
    echo -ne "${COLOR_DIM}Switch to branch #: ${COLOR_RESET}"
    read -r choice

    if [[ "$choice" =~ ^[0-9]+$ ]]; then
      local target
      target=$(echo "$branches" | sed -n "${choice}p")
      [[ -n "$target" ]] && do_switch "$target"
    fi
  fi
}

cmd_type() {
  local type="${1:-}"
  if [[ -z "$type" ]]; then
    echo -e "${COLOR_BOLD}Branch types in this repo:${COLOR_RESET}\n"
    git branch --format='%(refname:short)' | \
      grep '/' | sed 's|/.*||' | sort | uniq -c | sort -rn | \
      while read -r count name; do
        printf "  ${COLOR_CYAN}%-15s${COLOR_RESET} ${COLOR_DIM}(%d branches)${COLOR_RESET}\n" "$name" "$count"
      done
    echo ""
    echo -e "${COLOR_DIM}Usage: git-nav type <feature|bugfix|hotfix|...>${COLOR_RESET}"
    return 0
  fi

  cmd_list "$type/"
}

cmd_copy() {
  local ticket_only=false
  local desc_only=false
  local query=""

  for arg in "$@"; do
    if [[ "$arg" == "--ticket" ]]; then
      ticket_only=true
    elif [[ "$arg" == "--desc" ]]; then
      desc_only=true
    else
      query="$arg"
    fi
  done

  local branch
  if [[ -z "$query" ]]; then
    branch=$(current_branch)
  else
    branch=$(pick_branch "$query") || return 1
  fi

  local to_copy="$branch"
  if $ticket_only; then
    if [[ "$branch" =~ ([A-Z]+-[0-9]+) ]]; then
      to_copy="${BASH_REMATCH[1]}"
    else
      echo -e "${COLOR_YELLOW}No ticket ID found in branch: ${branch}${COLOR_RESET}"
      return 1
    fi
  elif $desc_only; then
    # Extract description part: type/TICKET-desc-words → "Desc Words"
    if [[ "$branch" =~ ^[^/]+/[A-Z]+-[0-9]+-(.+)$ ]]; then
      to_copy=$(title_case "$(echo "${BASH_REMATCH[1]}" | tr '-' ' ')")
    elif [[ "$branch" =~ ^[^/]+/(.+)$ ]]; then
      to_copy=$(title_case "$(echo "${BASH_REMATCH[1]}" | tr '-' ' ')")
    else
      to_copy=$(title_case "$(echo "$branch" | tr '-' ' ')")
    fi
  fi

  copy_to_clipboard "$to_copy"
  echo -e "${COLOR_GREEN}✓ Copied to clipboard:${COLOR_RESET} ${COLOR_BOLD}${to_copy}${COLOR_RESET}"
}

cmd_merge() {
  local git_args=()
  local query=""

  for arg in "$@"; do
    if [[ "$arg" == --* ]]; then
      git_args+=("$arg")
    else
      query="$arg"
    fi
  done

  if [[ -z "$query" ]]; then
    echo -e "${COLOR_RED}Usage: git-nav merge [--squash|--no-ff] <query>${COLOR_RESET}"
    return 1
  fi

  local branch
  branch=$(pick_branch "$query") || return 1

  echo -e "${COLOR_CYAN}Merging ${COLOR_BOLD}${branch}${COLOR_RESET}${COLOR_CYAN} into $(current_branch)...${COLOR_RESET}"
  git merge "${git_args[@]}" "$branch"
}

cmd_rebase() {
  local query="${1:-}"
  if [[ -z "$query" ]]; then
    echo -e "${COLOR_RED}Usage: git-nav rebase <query>${COLOR_RESET}"
    return 1
  fi

  local branch
  branch=$(pick_branch "$query") || return 1

  echo -e "${COLOR_CYAN}Rebasing onto ${COLOR_BOLD}${branch}${COLOR_RESET}${COLOR_CYAN}...${COLOR_RESET}"
  git rebase "$branch"
}

cmd_diff() {
  local git_args=()
  local query=""

  for arg in "$@"; do
    if [[ "$arg" == --* ]]; then
      git_args+=("$arg")
    else
      query="$arg"
    fi
  done

  if [[ -z "$query" ]]; then
    echo -e "${COLOR_RED}Usage: git-nav diff [--stat] <query>${COLOR_RESET}"
    return 1
  fi

  local branch
  branch=$(pick_branch "$query") || return 1

  git diff "${git_args[@]}" "$branch"
}

cmd_log() {
  local query="${1:-}"

  local branch
  if [[ -z "$query" ]]; then
    branch=$(current_branch)
  else
    branch=$(pick_branch "$query") || return 1
  fi

  git log "$branch"
}

cmd_delete() {
  local force=false
  local query=""

  for arg in "$@"; do
    if [[ "$arg" == "--force" || "$arg" == "-f" ]]; then
      force=true
    else
      query="$arg"
    fi
  done

  if [[ -z "$query" ]]; then
    echo -e "${COLOR_RED}Usage: git-nav delete [--force] <query>${COLOR_RESET}"
    return 1
  fi

  local branch
  branch=$(pick_branch "$query") || return 1

  echo -ne "${COLOR_YELLOW}Delete branch '${COLOR_BOLD}${branch}${COLOR_RESET}${COLOR_YELLOW}'? [y/N]: ${COLOR_RESET}"
  read -r confirm

  if [[ "$confirm" =~ ^[yY]$ ]]; then
    if $force; then
      git branch -D "$branch"
    else
      git branch -d "$branch"
    fi
    echo -e "${COLOR_GREEN}✓ Deleted branch ${COLOR_BOLD}${branch}${COLOR_RESET}"
  else
    echo -e "${COLOR_DIM}Aborted.${COLOR_RESET}"
  fi
}

cmd_branch() {
  local type="${1:-}"
  local ticket="${2:-}"
  local description="${3:-}"

  # Support shorthand: gnb AVEN-112 description (type defaults to feat)
  if [[ "$type" =~ ^[A-Z]+-[0-9]+$ ]]; then
    description="$ticket"
    ticket="$type"
    type="feat"
  fi

  if [[ -z "$type" || -z "$ticket" || -z "$description" ]]; then
    echo -e "${COLOR_RED}Usage: git-nav branch <type> <ticket> <description>${COLOR_RESET}"
    echo -e "${COLOR_DIM}  e.g. git-nav branch feat AVEN-112 my-new-feature${COLOR_RESET}"
    echo -e "${COLOR_DIM}  or   git-nav branch AVEN-112 my-new-feature  (type defaults to feat)${COLOR_RESET}"
    return 1
  fi

  # Normalize description: lowercase, spaces/underscores to hyphens, strip non-alphanumeric
  local slug
  slug=$(echo "$description" | tr '[:upper:]' '[:lower:]' | tr ' _' '-' | sed 's/[^a-z0-9-]//g' | sed 's/--*/-/g')

  local branch_name="${type}/${ticket}-${slug}"
  local base
  base=$(detect_base_branch)

  echo -e "${COLOR_CYAN}Syncing ${COLOR_BOLD}${base}${COLOR_RESET}${COLOR_CYAN}...${COLOR_RESET}"
  git checkout "$base" 2>/dev/null
  git pull origin "$base" 2>/dev/null || true

  echo -e "${COLOR_CYAN}Creating ${COLOR_BOLD}${branch_name}${COLOR_RESET}${COLOR_CYAN} from ${base}...${COLOR_RESET}"
  git checkout -b "$branch_name"
  record_switch "$branch_name"
  echo -e "${COLOR_GREEN}✓ Created and switched to ${COLOR_BOLD}${branch_name}${COLOR_RESET}"
}

cmd_what() {
  local query="${1:-}"

  local branch
  if [[ -z "$query" ]]; then
    branch=$(current_branch)
  else
    branch=$(pick_branch "$query") || return 1
  fi

  local base
  base=$(detect_base_branch)

  echo -e "${COLOR_BOLD}Branch:${COLOR_RESET} ${COLOR_CYAN}${branch}${COLOR_RESET}"

  if [[ "$branch" =~ ([A-Z]+-[0-9]+) ]]; then
    echo -e "${COLOR_BOLD}Ticket:${COLOR_RESET} ${COLOR_YELLOW}${BASH_REMATCH[1]}${COLOR_RESET}"
  fi

  local ahead behind
  ahead=$(git rev-list --count "${base}..${branch}" 2>/dev/null || echo 0)
  behind=$(git rev-list --count "${branch}..${base}" 2>/dev/null || echo 0)

  echo -e "${COLOR_BOLD}Base:${COLOR_RESET}   ${base} (${COLOR_GREEN}+${ahead} ahead${COLOR_RESET} / ${COLOR_RED}-${behind} behind${COLOR_RESET})"
  echo ""

  if [[ "$ahead" -gt 0 ]]; then
    echo -e "${COLOR_BOLD}Your commits (${ahead}):${COLOR_RESET}"
    git log --oneline "${base}..${branch}" | while IFS= read -r line; do
      echo -e "  ${COLOR_DIM}${line}${COLOR_RESET}"
    done
    echo ""
  fi

  local stat
  stat=$(git diff --stat "${base}...${branch}" 2>/dev/null | tail -1)
  if [[ -n "$stat" ]]; then
    echo -e "${COLOR_BOLD}Changes:${COLOR_RESET} ${stat}"
  fi
}

cmd_status() {
  local base
  base=$(detect_base_branch)

  local current
  current=$(current_branch)

  # Use history branches if available, otherwise fall back to recent local branches
  local branches
  if [[ -f "$HISTORY_FILE" && -s "$HISTORY_FILE" ]]; then
    branches=$(cat "$HISTORY_FILE")
  else
    branches=$(git branch --format='%(refname:short)' --sort=-committerdate | head -10)
  fi

  printf "\n${COLOR_BOLD}%-42s  %5s  %6s  %-8s${COLOR_RESET}\n" "BRANCH" "AHEAD" "BEHIND" "AGE"
  printf "${COLOR_DIM}%-42s  %5s  %6s  %-8s${COLOR_RESET}\n" "──────────────────────────────────────────" "─────" "──────" "────────"

  while IFS= read -r branch; do
    git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null || continue

    local ahead behind age
    ahead=$(git rev-list --count "${base}..${branch}" 2>/dev/null || echo 0)
    behind=$(git rev-list --count "${branch}..${base}" 2>/dev/null || echo 0)
    age=$(git log -1 --format='%cr' "$branch" 2>/dev/null || echo "?")

    local marker=""
    [[ "$branch" == "$current" ]] && marker="${COLOR_GREEN}●${COLOR_RESET} "

    local pr_info=""
    if command -v gh &>/dev/null; then
      local pr_number
      pr_number=$(gh pr list --head "$branch" --json number --jq '.[0].number' 2>/dev/null || true)
      [[ -n "$pr_number" ]] && pr_info="  ${COLOR_CYAN}← PR #${pr_number}${COLOR_RESET}"
    fi

    local display_branch="$branch"
    if [[ ${#branch} -gt 40 ]]; then
      display_branch="${branch:0:37}..."
    fi

    printf "  ${marker}${COLOR_RESET}%-40s  ${COLOR_GREEN}%5s${COLOR_RESET}  ${COLOR_RED}%6s${COLOR_RESET}  ${COLOR_DIM}%-8s${COLOR_RESET}%b\n" \
      "$display_branch" "$ahead" "$behind" "$age" "$pr_info"
  done <<< "$branches"

  echo ""
}

cmd_stash() {
  local subcommand="${1:-}"

  case "$subcommand" in
    pop)
      local current
      current=$(current_branch)

      local stash_list
      stash_list=$(git stash list 2>/dev/null || true)

      if [[ -z "$stash_list" ]]; then
        echo -e "${COLOR_YELLOW}No stashes found.${COLOR_RESET}"
        return 0
      fi

      echo -e "${COLOR_BOLD}Stashes (current branch first):${COLOR_RESET}\n"

      # Separate current-branch stashes from others
      local current_stashes=()
      local other_stashes=()
      while IFS= read -r line; do
        if echo "$line" | grep -qF "$current"; then
          current_stashes+=("$line")
        else
          other_stashes+=("$line")
        fi
      done <<< "$stash_list"

      local all_stashes=("${current_stashes[@]+"${current_stashes[@]}"}" "${other_stashes[@]+"${other_stashes[@]}"}")

      local idx=1
      for stash in "${all_stashes[@]}"; do
        local stash_ref stash_msg
        stash_ref=$(echo "$stash" | grep -o 'stash@{[0-9]*}')
        stash_msg=$(echo "$stash" | sed 's/stash@{[0-9]*}: //')
        if echo "$stash" | grep -qF "$current"; then
          printf "  ${COLOR_GREEN}%2d${COLOR_RESET}  ${COLOR_BOLD}%s${COLOR_RESET}  ${COLOR_DIM}%s${COLOR_RESET}\n" "$idx" "$stash_ref" "$stash_msg"
        else
          printf "  ${COLOR_YELLOW}%2d${COLOR_RESET}  ${COLOR_DIM}%s  %s${COLOR_RESET}\n" "$idx" "$stash_ref" "$stash_msg"
        fi
        ((idx++))
      done

      echo ""
      echo -ne "${COLOR_DIM}Pop stash #: ${COLOR_RESET}"
      read -r choice

      if [[ "$choice" =~ ^[0-9]+$ && "$choice" -ge 1 && "$choice" -le "${#all_stashes[@]}" ]]; then
        local selected="${all_stashes[$((choice-1))]}"
        local stash_ref
        stash_ref=$(echo "$selected" | grep -o 'stash@{[0-9]*}')
        git stash pop "$stash_ref"
        echo -e "${COLOR_GREEN}✓ Popped ${stash_ref}${COLOR_RESET}"
      else
        echo -e "${COLOR_DIM}No selection made.${COLOR_RESET}"
      fi
      ;;

    "")
      local current
      current=$(current_branch)
      local timestamp
      timestamp=$(date '+%H:%M')
      local message="${current} @ ${timestamp}"
      git stash push -m "$message"
      echo -e "${COLOR_GREEN}✓ Stashed as: ${COLOR_BOLD}${message}${COLOR_RESET}"
      ;;

    *)
      echo -e "${COLOR_RED}Usage: git-nav stash [pop]${COLOR_RESET}"
      return 1
      ;;
  esac
}

cmd_pr() {
  if ! command -v gh &>/dev/null; then
    echo -e "${COLOR_RED}Error: 'gh' CLI not found. Install from https://cli.github.com${COLOR_RESET}"
    return 1
  fi

  local base="${1:-}"
  if [[ -z "$base" ]]; then
    base=$(detect_base_branch)
  fi

  local branch
  branch=$(current_branch)

  # Auto-populate title from branch name
  local title="$branch"
  if [[ "$branch" =~ ^[^/]+/([A-Z]+-[0-9]+)-(.+)$ ]]; then
    local ticket="${BASH_REMATCH[1]}"
    local desc
    desc=$(title_case "$(echo "${BASH_REMATCH[2]}" | tr '-' ' ')")
    title="${ticket}: ${desc}"
  fi

  echo -e "${COLOR_CYAN}Creating PR: ${COLOR_BOLD}${branch}${COLOR_RESET}${COLOR_CYAN} → ${base}${COLOR_RESET}"
  echo -e "${COLOR_DIM}Title: ${title}${COLOR_RESET}"

  local url
  url=$(gh pr create --base "$base" --title "$title" --body "" 2>&1) || {
    echo -e "${COLOR_RED}✗ Failed to create PR${COLOR_RESET}"
    echo -e "${COLOR_DIM}${url}${COLOR_RESET}"
    return 1
  }

  echo -e "${COLOR_GREEN}✓ PR created: ${COLOR_BOLD}${branch}${COLOR_RESET}${COLOR_GREEN} → ${base}${COLOR_RESET}"
  echo -e "  ${COLOR_CYAN}${url}${COLOR_RESET}"
}

cmd_interactive() {
  local current
  current=$(current_branch)
  echo -e "${COLOR_BOLD}🔀 Git Branch Navigator${COLOR_RESET}"
  echo -e "${COLOR_DIM}Current: ${COLOR_GREEN}$(format_branch_name "$current" "$current")${COLOR_RESET}\n"

  echo -e "  ${COLOR_YELLOW}s${COLOR_RESET}  Search branches (fuzzy)"
  echo -e "  ${COLOR_YELLOW}l${COLOR_RESET}  List all branches"
  echo -e "  ${COLOR_YELLOW}r${COLOR_RESET}  Recent branches"
  echo -e "  ${COLOR_YELLOW}t${COLOR_RESET}  Find by ticket ID"
  echo -e "  ${COLOR_YELLOW}y${COLOR_RESET}  Browse by type (feature/bugfix/...)"
  echo -e "  ${COLOR_YELLOW}b${COLOR_RESET}  Go back (previous branch)"
  echo -e "  ${COLOR_YELLOW}q${COLOR_RESET}  Quit"
  echo ""
  echo -ne "${COLOR_DIM}Choose: ${COLOR_RESET}"
  read -r action

  case "$action" in
    s)
      echo -ne "${COLOR_DIM}Search query: ${COLOR_RESET}"
      read -r query
      cmd_search "$query"
      ;;
    l) cmd_list ;;
    r) cmd_recent ;;
    t)
      echo -ne "${COLOR_DIM}Ticket ID: ${COLOR_RESET}"
      read -r ticket
      cmd_ticket "$ticket"
      ;;
    y) cmd_type ;;
    b) cmd_back ;;
    q) return 0 ;;
    *) echo -e "${COLOR_RED}Unknown option.${COLOR_RESET}" ;;
  esac
}

cmd_help() {
  echo -e "${COLOR_BOLD}🔀 git-nav — Smart Git Branch Navigator${COLOR_RESET}"
  echo ""
  echo -e "${COLOR_BOLD}NAVIGATION:${COLOR_RESET}"
  echo -e "  ${COLOR_CYAN}git-nav${COLOR_RESET}                          Interactive mode"
  echo -e "  ${COLOR_CYAN}git-nav search${COLOR_RESET} <query>           Fuzzy search branches"
  echo -e "  ${COLOR_CYAN}git-nav list${COLOR_RESET} [filter]            List branches (sorted by recent commit)"
  echo -e "  ${COLOR_CYAN}git-nav recent${COLOR_RESET}                   Show recently visited branches"
  echo -e "  ${COLOR_CYAN}git-nav back${COLOR_RESET} [n]                 Switch to nth previous branch (default: 1)"
  echo -e "  ${COLOR_CYAN}git-nav ticket${COLOR_RESET} <ID>              Find branch by ticket (e.g. AVEN-43)"
  echo -e "  ${COLOR_CYAN}git-nav type${COLOR_RESET} [type]              Browse by prefix (feature/bugfix/...)"
  echo ""
  echo -e "${COLOR_BOLD}BRANCH OPERATIONS:${COLOR_RESET}"
  echo -e "  ${COLOR_CYAN}git-nav branch${COLOR_RESET} [type] <ticket> <desc>  Create branch, syncs base first (type defaults to 'feat')"
  echo -e "  ${COLOR_CYAN}git-nav copy${COLOR_RESET} [query]             Copy branch name to clipboard"
  echo -e "  ${COLOR_CYAN}git-nav copy --ticket${COLOR_RESET} [query]    Copy only the ticket ID (e.g. AVEN-43)"
  echo -e "  ${COLOR_CYAN}git-nav copy --desc${COLOR_RESET} [query]      Copy description, title-cased (e.g. 'Add Payment Flow')"
  echo -e "  ${COLOR_CYAN}git-nav pr${COLOR_RESET} [base]                Open PR for current branch (default base: main)"
  echo -e "  ${COLOR_CYAN}git-nav merge${COLOR_RESET} [flags] <query>    Merge branch into current (supports --squash, --no-ff)"
  echo -e "  ${COLOR_CYAN}git-nav rebase${COLOR_RESET} <query>           Rebase current branch onto matched branch"
  echo -e "  ${COLOR_CYAN}git-nav diff${COLOR_RESET} [--stat] <query>    Diff current branch against matched branch"
  echo -e "  ${COLOR_CYAN}git-nav log${COLOR_RESET} [query]              Show git log for matched branch (current if no query)"
  echo -e "  ${COLOR_CYAN}git-nav delete${COLOR_RESET} [--force] <query> Delete matched branch (prompt for confirmation)"
  echo ""
  echo -e "${COLOR_BOLD}CONTEXT & STATUS:${COLOR_RESET}"
  echo -e "  ${COLOR_CYAN}git-nav what${COLOR_RESET} [query]             Commits + diff summary for a branch"
  echo -e "  ${COLOR_CYAN}git-nav status${COLOR_RESET}                   Dashboard: ahead/behind/age for recent branches"
  echo -e "  ${COLOR_CYAN}git-nav stash${COLOR_RESET}                    Stash with branch+timestamp message"
  echo -e "  ${COLOR_CYAN}git-nav stash pop${COLOR_RESET}                Pop stash (current branch stashes shown first)"
  echo ""
  echo -e "${COLOR_BOLD}EXAMPLES:${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}git-nav branch AVEN-112 add-payment-flow       # creates feat/AVEN-112-add-payment-flow${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}git-nav copy --desc                            # copies 'Add Payment Flow'${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}git-nav pr                                     # PR → main with auto title${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}git-nav pr develop                             # PR → develop${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}git-nav what                                   # summary of current branch${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}git-nav status                                 # overview of recent branches${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}git-nav stash                                  # stash as 'feat/AVEN-111 @ 14:32'${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}git-nav search aven43                          # fuzzy → AVEN-43${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}git-nav copy --ticket                          # copy ticket ID from current branch${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}git-nav merge main                             # merge main into current${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}git-nav diff --stat main                       # show changed files vs main${COLOR_RESET}"
  echo ""
  echo -e "${COLOR_BOLD}SHELL ALIASES:${COLOR_RESET}"
  echo -e "  ${COLOR_CYAN}gn${COLOR_RESET}      git-nav (interactive)"
  echo -e "  ${COLOR_CYAN}gnb${COLOR_RESET}     git-nav branch"
  echo -e "  ${COLOR_CYAN}gnc${COLOR_RESET}     git-nav copy"
  echo -e "  ${COLOR_CYAN}gnpr${COLOR_RESET}    git-nav pr"
  echo -e "  ${COLOR_CYAN}gnm${COLOR_RESET}     git-nav merge"
  echo -e "  ${COLOR_CYAN}gnrb${COLOR_RESET}    git-nav rebase"
  echo -e "  ${COLOR_CYAN}gnd${COLOR_RESET}     git-nav diff"
  echo -e "  ${COLOR_CYAN}gnl${COLOR_RESET}     git-nav log"
  echo -e "  ${COLOR_CYAN}gndel${COLOR_RESET}   git-nav delete"
  echo -e "  ${COLOR_CYAN}gnw${COLOR_RESET}     git-nav what"
  echo -e "  ${COLOR_CYAN}gns${COLOR_RESET}     git-nav status"
  echo -e "  ${COLOR_CYAN}gnst${COLOR_RESET}    git-nav stash"
  echo -e "  ${COLOR_CYAN}gnkeys${COLOR_RESET}  git-nav help"
}

# ── Main ────────────────────────────────────────────────────
ensure_git_repo

case "${1:-}" in
  search|s|find|f)    shift; cmd_search "${*:-}" ;;
  list|l|ls)          shift; cmd_list "${1:-}" ;;
  recent|r)           cmd_recent ;;
  back|b|prev|-)      shift; cmd_back "${1:-1}" ;;
  ticket|t|jira|j)    shift; cmd_ticket "${*:-}" ;;
  type|y|prefix)      shift; cmd_type "${1:-}" ;;
  copy|cp|yank)       shift; cmd_copy "${@:-}" ;;
  branch|br)          shift; cmd_branch "${@:-}" ;;
  pr)                 shift; cmd_pr "${@:-}" ;;
  merge|mg)           shift; cmd_merge "${@:-}" ;;
  rebase|rb)          shift; cmd_rebase "${@:-}" ;;
  diff|d)             shift; cmd_diff "${@:-}" ;;
  log|lg)             shift; cmd_log "${@:-}" ;;
  delete|del|rm)      shift; cmd_delete "${@:-}" ;;
  what|w)             shift; cmd_what "${@:-}" ;;
  status|st)          shift; cmd_status ;;
  stash)              shift; cmd_stash "${@:-}" ;;
  --version|-V|version) echo "git-nav 1.0.0"; exit 0 ;;
  help|h|--help|-h)   cmd_help ;;
  "")                 cmd_interactive ;;
  *)
    # If arg doesn't match a command, treat it as a search query
    cmd_search "$*"
    ;;
esac
